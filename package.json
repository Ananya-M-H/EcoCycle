{
  "name": "ecocycle-ewaste-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Blockchain-verified e-waste collection and rewards platform",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "chain": "hardhat node",
    "deploy:local": "hardhat run blockchain/scripts/deploy.js --network localhost",
    "env:init": "node backend/scripts/init-local-env.js",
    "db:init": "node backend/scripts/init-replica-set.js",
    "seed:admin": "node backend/scripts/seed-admin.js",
    "test:api": "node tests/api.integration.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ethers": "^6.15.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "multer": "^2.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "chai": "^4.5.0",
    "hardhat": "^2.26.3"
  },
  "engines": {
    "node": ">=20"
  }
}